{
  "openapi": "3.0.3",
  "info": {
    "title": "Finances API V1",
    "description": "Finances API - Version 1",
    "version": "v1"
  },
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "components": {
    "schemas": {
      "movement": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "kind": {
            "type": "string",
            "enum": [
              "income",
              "expense"
            ]
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "description": {
            "type": "string"
          },
          "amount": {
            "type": "string",
            "example": "1500.50"
          },
          "currency": {
            "type": "string",
            "example": "ARS"
          },
          "category_id": {
            "type": "integer",
            "nullable": true
          },
          "category": {
            "type": "string",
            "nullable": true,
            "description": "Name of the root category (read only)"
          },
          "subcategory": {
            "type": "string",
            "nullable": true,
            "description": "Name of the subcategory, if any (read only)"
          },
          "event_id": {
            "type": "integer",
            "nullable": true
          },
          "payment_method": {
            "type": "string",
            "nullable": true,
            "enum": [
              "cash",
              "debit_card",
              "credit_card",
              "transfer",
              "other",
              null
            ]
          },
          "credit_card": {
            "type": "string",
            "nullable": true,
            "description": "Required when payment_method is credit_card, null otherwise",
            "enum": [
              "visa",
              "amex",
              "mercado_pago",
              "other",
              null
            ]
          },
          "beneficiary": {
            "type": "string",
            "nullable": true
          },
          "notes": {
            "type": "string",
            "nullable": true
          },
          "shared": {
            "type": "boolean"
          }
        }
      },
      "error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object"
          }
        },
        "required": [
          "code",
          "message",
          "details"
        ]
      },
      "user": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "token_header": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization"
      }
    }
  },
